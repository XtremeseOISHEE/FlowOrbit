<?xml version="1.0" encoding="utf-8"?>
<!-- FlowOrbit mark: an open teal orbit ring with a mauve "planet" sitting in the gap,
     wrapped around a mint F. Kept inside the adaptive-icon safe zone (66dp circle, centered). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- orbit ring, open near the top-right -->
    <path
        android:pathData="M85.88,51.21 A32,32 0 1 1 62.28,23.09"
        android:strokeColor="#308196"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- orbit "planet" dot sitting in the ring's gap -->
    <path
        android:pathData="M78.5,33.4 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:fillColor="#9E6987"/>

    <!-- F glyph -->
    <path
        android:pathData="M40,36 L48,36 L48,82 L40,82 Z M40,36 L70,36 L70,45 L40,45 Z M40,56 L64,56 L64,64 L40,64 Z"
        android:fillColor="#80D5CA"/>
</vector>
